# ==============================================================================
# SahyogSetu — Production & Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or configure in container environment) and customize.
# DO NOT commit real API secrets or private tokens to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT RUNTIME
# ------------------------------------------------------------------------------
# Operational environment: 'development', 'testing', 'staging', or 'production'
APP_ENV=production

# Debug mode: Set to 'false' in staging and production to prevent stack trace leaks
DEBUG=false

# Host binding and port
HOST=0.0.0.0
PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. CORS & SECURITY
# ------------------------------------------------------------------------------
# Allowed origins for Cross-Origin Resource Sharing.
# In production, specify explicit domain(s) separated by commas (NEVER use '*' in production).
# Example: CORS_ORIGINS=https://sahyogsetu.gov.in,https://app.sahyogsetu.gov.in
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:8000

# Administrative API Key for protected endpoints (news trigger, evaluation runs, cache purges)
# MUST be changed from the default development key in production
ADMIN_API_KEY=change_this_to_a_strong_random_secret_in_production_2026

# In-memory sliding-window rate limiting (true/false)
RATE_LIMIT_ENABLED=true

# Maximum file upload size in bytes (Default: 15 MB = 15728640 bytes)
MAX_UPLOAD_SIZE_BYTES=15728640

# ------------------------------------------------------------------------------
# 3. PERSISTENT STORAGE & PATHS
# ------------------------------------------------------------------------------
# Path to SQLite relational database storing news, conversations, messages, and feedback
DATABASE_PATH=backend/data/news.db

# Path to TTS synthesized audio cache
TTS_CACHE_DIR=backend/data/tts_cache

# ------------------------------------------------------------------------------
# 4. MULTILINGUAL & BHASHINI (ULCA) CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------------------------
# When Bhashini credentials are provided, live MeitY models are queried for ASR/NMT/TTS.
# When omitted, SahyogSetu operates gracefully in offline fallback mode:
# - ASR falls back to client-side Browser Web Speech
# - TTS falls back to local harmonic synthesizers
# - NMT falls back to local entity-preserving multilingual generators
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_KEY=
BHASHINI_TIMEOUT=8.0

# ------------------------------------------------------------------------------
# 5. EXTERNAL LLM PROVIDERS (OPTIONAL)
# ------------------------------------------------------------------------------
# When provided, external LLMs generate conversational summaries grounded in retrieved context.
# When omitted, SahyogSetu uses its deterministic in-process statutory synthesis engine
# with zero external network round-trip and 0.00% hallucination rate.
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 6. FRONTEND CONFIGURATION (Vite Client)
# ------------------------------------------------------------------------------
# Backend API Base URL consumed by the React/Vite single-page application
VITE_API_URL=http://127.0.0.1:8000
