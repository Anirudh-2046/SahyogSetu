# SahyogSetu Frontend Environment Configuration
# Copy this file to .env or .env.local for local overrides.
#
# IMPORTANT SECURITY NOTICE:
# - Frontend variables prefixed with VITE_ are embedded into the client bundle and visible to anyone.
# - NEVER store API keys (OpenAI, Gemini, Bhashini, Anthropic), database credentials, or secret tokens here.
# - All AI, ML, TTS, ASR, and translation keys MUST reside exclusively in the backend `.env`.

# Authoritative backend API base URL
# Leave empty for relative path proxying in production / Docker / NGINX reverse-proxy setups.
# For local development with separate frontend (port 5173) and backend (port 8000):
VITE_API_URL=http://127.0.0.1:8000
